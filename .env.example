VITE_API_URL_SERVER=https://myiipea.ci

# Ou sont servies les photos et les pieces jointes. Facultatif : sans lui, elles
# sont demandees a VITE_API_URL_SERVER, ce qui est le cas en production.
# En developpement, l'API tourne en local alors que la base est celle de
# production : les fichiers /uploads/... n'existent que sur le serveur distant.
# Renseigner cette variable permet d'afficher les vraies photos en local.
# VITE_URL_MEDIAS=https://myiipea.ci
